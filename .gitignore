.playwright-mcp/
.claude-env
.DS_Store
_site/
node_modules/
dist/
*.solution.json

# Scratch crop of the prior week's printed answer grid, made fresh by
# fetch_issue.py each week and consumed once its letters are transcribed
# into that week's solution hashes -- never worth keeping or committing.
working-files/*/printed_solution_grid_CANDIDATE.jpg
.wrangler/

# A global gitignore rule (~/.gitignore_global: ".*") hides every dotfile
# directory, which would silently drop .claude/ -- and project-dry.md with
# it. Track it here on purpose.
!.claude/
